{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev:web",
      "type": "npm",
      "script": "dev:web",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building|Changes detected",
          "endsPattern": "bundle generation (complete|failed)"
        }
      }
    },
    {
      "label": "dev:api",
      "type": "npm",
      "script": "dev:api",
      "isBackground": true,
      "problemMatcher": "$msCompile"
    },
    {
      "label": "check",
      "type": "npm",
      "script": "check",
      "problemMatcher": ["$tsc", "$msCompile"]
    }
  ]
}
