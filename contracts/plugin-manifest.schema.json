{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nas-for-windows.local/schemas/plugin-manifest.schema.json",
  "title": "NasForWindows plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "minHostApiVersion",
    "navigation",
    "pages"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "minHostApiVersion": {
      "type": "string",
      "minLength": 1
    },
    "navigation": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/navigationItem"
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page"
      }
    }
  },
  "$defs": {
    "navigationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "pageId"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "pageId": {
          "type": "string",
          "minLength": 1
        },
        "permission": {
          "type": "string"
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": ["data-table", "detail", "form", "dashboard"]
        }
      }
    }
  }
}
