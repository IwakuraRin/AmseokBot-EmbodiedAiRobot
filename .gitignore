**/.angular/cache
/apps/api/data/
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# Local configuration and secrets
.env
.env.*
!.env.example
!.env.*.example
**/appsettings.Local.json
**/appsettings.*.local.json
**/secrets.json
*.key
*.pem
*.p12
*.pfx
*.snk

# Runtime databases and protected key material
*.db
*.db-shm
*.db-wal
**/data-protection-keys/

# System files
.DS_Store
Thumbs.db
